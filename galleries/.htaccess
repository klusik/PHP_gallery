# Project: PHP Gallery
# Repository: https://github.com/klusik/PHP_gallery
#
# File: galleries/.htaccess
# Module Type: Web Server Configuration
#
# Purpose:
#   Defines Apache-level access, routing, and safety behavior for this directory.
#
# Responsibilities:
#   - Protect sensitive files and folders
#   - Keep public routing behavior predictable
#   - Avoid server rules that conflict with PHP application routing
#
# Author:
#   Rudolf Klusal
#
# Contact:
#   https://github.com/klusik
#
# License:
#   MIT License (see LICENSE file in repository)
#
# Notes:
#   - Keep comments and docstrings intact when modifying this file.
#   - Prefer small, readable changes over broad rewrites.
#
# Last Updated:
#   2026-10-05

Options -Indexes
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "\.(dng|DNG)$">
        Require all denied
    </FilesMatch>

    # Deny direct browser access to stored gallery files.
    # Media should be served by PHP routes so gallery visibility, password, share-link, and NSFW rules are applied.
    <FilesMatch "\.(?:jpe?g|png|gif|webp|avif|svg|bmp|tiff?|heic|heif|dng|DNG|json|txt|zip|pdf)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "\.(dng|DNG)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "\.(?:jpe?g|png|gif|webp|avif|svg|bmp|tiff?|heic|heif|dng|DNG|json|txt|zip|pdf)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
