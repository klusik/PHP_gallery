# Project: PHP Gallery
# Repository: https://github.com/klusik/PHP_gallery
#
# File: .htaccess
# Module Type: Web Server Configuration
#
# Purpose:
#   Defines Apache-level access, routing, and safety behavior for this directory.
#
# Responsibilities:
#   - Protect sensitive files and folders
#   - Keep public routing behavior predictable
#   - Avoid server rules that conflict with PHP application routing
#
# Author:
#   Rudolf Klusal
#
# Contact:
#   https://github.com/klusik
#
# License:
#   MIT License (see LICENSE file in repository)
#
# Notes:
#   - Keep comments and docstrings intact when modifying this file.
#   - Prefer small, readable changes over broad rewrites.
#
# Last Updated:
#   2026-05-04

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # In per-directory context the RewriteRule path is relative to this application
    # root, so this protects internal repository trees under both /Galerie/ and /
    # without blocking public gallery slugs that merely contain these words later.
    RewriteRule ^(?:app|database|scripts|cache|data|logs|tmp|tests|deploy)(?:/|$) - [R=404,L,NC]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ public/index.php [L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header unset Pragma
        Header unset Expires
    </FilesMatch>

    <FilesMatch "\.(?:jpg|jpeg|png|gif|webp|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header unset Pragma
        Header unset Expires
    </FilesMatch>

    <FilesMatch "\.(?:html?|json|xml)$">
        Header set Cache-Control "public, max-age=300"
        Header unset Pragma
        Header unset Expires
    </FilesMatch>
</IfModule>

<FilesMatch "^(config|config\.example)\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(?:md|markdown|bat|cmd|ps1|sql|zip|log|tmp|bak|backup|old|orig|dist|ini|env|yml|yaml|lock)$">
    Require all denied
</FilesMatch>

RedirectMatch 404 (^|/)\.git(/|$)
RedirectMatch 404 (^|/)\.(?!well-known/)

