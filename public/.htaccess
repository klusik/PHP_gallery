# Project: PHP Gallery
# Repository: https://github.com/klusik/PHP_gallery
#
# File: public/.htaccess
# Module Type: Web Server Configuration
#
# Purpose:
#   Defines Apache-level access, routing, and safety behavior for this directory.
#
# Responsibilities:
#   - Protect sensitive files and folders
#   - Keep public routing behavior predictable
#   - Avoid server rules that conflict with PHP application routing
#
# Author:
#   Rudolf Klusal
#
# Contact:
#   https://github.com/klusik
#
# License:
#   MIT License (see LICENSE file in repository)
#
# Notes:
#   - Keep comments and docstrings intact when modifying this file.
#   - Prefer small, readable changes over broad rewrites.
#
# Last Updated:
#   2026-05-04

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep internal repository tree names outside the public route namespace too.
    # In the recommended public/ document-root layout these trees are already
    # physically outside the web root; this is defense in depth and preserves a
    # deterministic 404 if a host exposes an unexpected mapping.
    RewriteRule ^(?:app|database|scripts|cache|data|logs|tmp|tests|deploy)(?:/|$) - [R=404,L,NC]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

